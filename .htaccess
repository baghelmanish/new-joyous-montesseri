# =====================================================
# Joyous Montessori (joyousmontessori.com) - .htaccess
# =====================================================


# No directory listings, and MultiViews off (conflicts with clean-URL rules)
Options -Indexes -MultiViews
DirectoryIndex index.html


RewriteEngine On


# -----------------------------------------------------
# 1. Force HTTPS and non-www
# -----------------------------------------------------
# www -> non-www (https)
RewriteCond % { HTTP_HOST } ^www\. [NC]
RewriteRule ^ https://joyousmontessori.com% { REQUEST_URI } [R=301, L]


# http -> https (also safe behind Cloudflare / proxy, no redirect loop)
RewriteCond % { HTTPS } off
RewriteCond % { HTTP:X-Forwarded-Proto } !https [NC]
RewriteRule ^ https://joyousmontessori.com% { REQUEST_URI } [R=301, L]


# -----------------------------------------------------
# 2. Old WordPress URLs -> matching Joyous pages
# -----------------------------------------------------
RewriteRule ^programs/?$   /our-programs  [R=301, L]
RewriteRule ^gallery/?$    /photo-gallery [R=301, L]
RewriteRule ^employment/?$ /career        [R=301, L]
RewriteRule ^feed/?$       /              [R=301, L]
RewriteRule ^Facebook/?$   https://www.facebook.com/JoyousMontessoriKellerSouthlakeFortworth [R=301, L]
# RewriteRule ^pricing/?$  /current-offers [R=301,L]   # uncomment if this is the right target


# WordPress admin/login/xmlrpc are gone (wp-content is NOT blocked: og:image still uses it)
RewriteRule ^(wp-admin | wp-includes | wp-login\.php | xmlrpc\.php) - [R=410, L]


# -----------------------------------------------------
# 3. Clean URLs (hide .html)
# -----------------------------------------------------
# index.html -> / (or /folder/)
RewriteCond % { THE_REQUEST } \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301, L]


# something.html -> /something
RewriteCond % { THE_REQUEST } \s/[^\s?#]+\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301, L]


# /something -> something.html (internal, no redirect)
RewriteCond % { REQUEST_FILENAME } !-f
RewriteCond % { REQUEST_FILENAME } !-d
RewriteCond % { DOCUMENT_ROOT }/$1.html -f
RewriteRule ^([^.]+)$ $1.html [L]


# Custom 404 (create 404.html first, then uncomment)
# ErrorDocument 404 /404.html


# -----------------------------------------------------
# 4. Security
# -----------------------------------------------------
RedirectMatch 404 /\.(?!well-known)


<FilesMatch "\.(bak|orig|swp|sql|log|ini|sh|env)$">
Require all denied
</FilesMatch>


<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# Enable only after confirming HTTPS works on every page:
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>


# -----------------------------------------------------
# 5. Performance
# -----------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>


<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/jpg  "access plus 1 year"
ExpiresByType image/png  "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/gif  "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 year"
</IfModule>